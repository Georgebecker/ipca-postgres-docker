{
  "agente": {
    "modelo": "deepseek-v4-flash",
    "esforco_raciocinio": "high",
    "temperatura": 0.2
  },
  "verificacao": {
    "diretorio_de_trabalho": "workspace",
    "comandos": [
      "python -m py_compile scripts/baixar_dados.py scripts/gerar_seed.py"
    ],
    "parar_no_primeiro_erro": true,
    "timeout_segundos": 900
  },
  "metrica": {
    "nome": "Linhas prontas para carga (seed.sql)",
    "unidade": "linhas",
    "direcao": "maior_melhor",
    "comando": "python scripts/gerar_seed.py",
    "regex": "linhas totais\\s*:\\s*([0-9]+)",
    "grupo": 1
  },
  "limites": {
    "max_iteracoes": 20,
    "rejeicoes_consecutivas": 5
  },
  "projeto": {
    "nome": "ipca-postgres-docker",
    "degrau": 1,
    "apelido": "Termometro",
    "workspace": "workspace/",
    "log": "meu-loop-agente/log.md",
    "baseline": "meu-loop-agente/baseline.json",
    "verificador": "meu-loop-agente/verificar_iteracao.py",
    "system_prompt": "meu-loop-agente/system_prompt.md"
  }
}
