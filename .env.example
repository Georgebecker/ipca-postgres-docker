# =========================================================
#  IPCA Postgres Docker — variáveis de ambiente
#  Passo 1: copie este arquivo para `.env`
#  Passo 2: preencha com os valores do SEU ambiente
#  NUNCA envie o `.env` para o repositório (está no .gitignore)
# =========================================================

# --- Projeto / caminhos ------------------------------------
PROJETO_NOME=ipca-postgres-docker
PASTA_RAIZ=.
PASTA_DADOS_RAW=data/raw
PASTA_DADOS_PROCESSED=data/processed
PASTA_NOTEBOOKS=notebooks
PASTA_SAIDAS=saidas

# --- Banco de dados (PostgreSQL) ---------------------------
# Ainda não há docker-compose neste projeto (primeiro ciclo pendente).
# Preencha no `.env` local; nunca versione usuário/senha reais.
# DB_URL=postgresql://USUARIO:SENHA@localhost:5432/ipca
DB_ECHO=false

# --- Execução / qualidade -----------------------------------
LOG_NIVEL=INFO
SEMENTE_ALEATORIA=42

# --- APIs externas (opcionais — preencher só se for usar) ---
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# HF_TOKEN=