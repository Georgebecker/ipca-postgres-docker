# =========================================================
#  IPCA Postgres Docker — variáveis de ambiente
#  Passo 1: copie este arquivo para `.env`
#  Passo 2: preencha com os valores do SEU ambiente
#  NUNCA envie o `.env` para o repositório (está no .gitignore)
# =========================================================

# --- Projeto / caminhos ------------------------------------
PROJETO_NOME=ipca-postgres-docker
PASTA_RAIZ=.
PASTA_DADOS_RAW=data/raw
PASTA_DADOS_PROCESSED=data/processed
PASTA_NOTEBOOKS=notebooks
PASTA_SAIDAS=saidas
POSTGRES_USER=termometro
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=termometro
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- API (FastAPI) -----------------------------------------
# Porta publicada no host. Dentro do container a API sempre escuta 8000.
API_PORT=8000

# --- Banco escolhido (o instalador grava aqui) -------------
# postgres = padrao do projeto | mysql = extra opcional (experimental)
BANCO=postgres

# --- Ambiente (o instalador grava aqui) --------------------
# docker = PostgreSQL em container local | neon = PostgreSQL na nuvem
# Se ficar vazio, o instalador decide: usa neon quando existir DATABASE_URL.
AMBIENTE=docker

# --- MySQL (opcional, usado so se BANCO=mysql) -------------
# Suba com: docker compose -f docker-compose.mysql.yml up -d
MYSQL_ROOT_PASSWORD=troque_esta_senha
MYSQL_DATABASE=termometro
MYSQL_PORT=3306

